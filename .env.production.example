# Production environment — copy to .env on the server (never commit .env).
#   cp .env.production.example .env
#   chmod +x scripts/generate-secrets.sh && ./scripts/generate-secrets.sh
#   # Merge lines from backups/prod-secrets.env into .env (git-ignored).
#
# Deploy with:  docker compose -f docker-compose.prod.yml up -d --build
# Quick Tunnel: CADDYFILE=Caddyfile.tunnel  (see docs/CLOUDFLARE-TUNNEL-SETUP.md)

# --- Public site ----------------------------------------------------------------
# Hostname Caddy serves (Let's Encrypt when using default Caddyfile + public 80/443).
# For Cloudflare Quick Tunnel, set DOMAIN to a placeholder (e.g. portal.local) and use
# Caddyfile.tunnel; then set CORS_ORIGINS / WEB_BASE_URL to the https://*.trycloudflare.com URL.
DOMAIN=portal.example.com
ACME_EMAIL=admin@example.com
# Browser origins allowed by the API (comma-separated). No localhost or * in production.
CORS_ORIGINS=https://portal.example.com
WEB_BASE_URL=https://portal.example.com

# --- App ------------------------------------------------------------------------
APP_ENV=production
APP_VERSION=0.1.0
LOG_LEVEL=INFO
ORG_NAME="CA PLUS Tech Pvt. Ltd."
NEXT_PUBLIC_API_URL=
# Which Caddy config to mount (Caddyfile = TLS; Caddyfile.tunnel = HTTP :80 for Quick Tunnel).
CADDYFILE=Caddyfile

# --- PostgreSQL -----------------------------------------------------------------
# Not published on the host in docker-compose.prod.yml (internal network only).
POSTGRES_USER=hrportal
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=hrportal
# Compose injects DATABASE_URL; set only if you run the API outside Compose:
# DATABASE_URL=postgresql+asyncpg://hrportal:PASSWORD@postgres:5432/hrportal

# --- Valkey / Celery ------------------------------------------------------------
# Host ports are not published in prod; URLs use the valkey service name.
REDIS_URL=redis://valkey:6379/0
CELERY_BROKER_URL=redis://valkey:6379/1
CELERY_RESULT_BACKEND=redis://valkey:6379/2

# --- Auth -----------------------------------------------------------------------
# Must be ≥32 random characters in production (scripts/generate-secrets.sh).
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- S3 / MinIO -----------------------------------------------------------------
# MinIO ports are NOT published in prod. CVs download via the API by default.
MINIO_ROOT_USER=REPLACE_WITH_MINIO_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_MINIO_PASSWORD
S3_ENDPOINT_URL=http://minio:9000
# Only needed when CV_DOWNLOAD_VIA_API=false (browser talks to MinIO/S3 directly).
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY_ID=REPLACE_WITH_MINIO_USER
S3_SECRET_ACCESS_KEY=REPLACE_WITH_MINIO_PASSWORD
S3_BUCKET=cvs
S3_REGION=us-east-1
# true (recommended): same-origin /api/v1/documents/{id}/content?token=… — MinIO stays private.
CV_DOWNLOAD_VIA_API=true

# --- SMTP -----------------------------------------------------------------------
# Free options for testing: Brevo / SendGrid / Mailjet free tiers, or Gmail App Password
# (SMTP_HOST=smtp.gmail.com, PORT=587, USE_TLS=true). Prefer a real transactional provider
# for production HR mail. Leave USER/PASSWORD empty only if the relay allows unauthenticated.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=hr@example.com
SMTP_FROM_NAME="HR Portal"

# --- Optional modules (all off for a minimal go-live) ---------------------------
ENABLE_PUBLIC_CAREERS=false
ENABLE_INTERVIEWS=false
ENABLE_OFFERS=false
ENABLE_REQUISITIONS=false
ENABLE_AUDIT_UI=false

# --- Security -------------------------------------------------------------------
API_RATE_LIMIT_PER_MINUTE=300
# Forced true automatically when APP_ENV=production (HttpOnly + Secure + SameSite=Lax refresh cookie).
COOKIE_SECURE=true
# true behind Caddy / Cloudflare Tunnel so rate limits see the real client IP.
TRUST_PROXY_HEADERS=true

# --- ClamAV (optional: docker compose --profile clamav) -------------------------
# Leave empty to skip scanning. Set to clamav when the clamav service is running.
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Backups --------------------------------------------------------------------
BACKUP_RETENTION_DAYS=14
# Optional: 32+ character passphrase → encrypted db.dump.enc + cvs.tar.enc
# BACKUP_ENCRYPTION_KEY=

# --- Retention (rejected candidates); 0 = disabled ------------------------------
RETENTION_REJECTED_DAYS=0