# Production environment — copy to .env on the server (never commit .env).
#   cp .env.production.example .env
# Or merge generated secrets:  cat backups/prod-secrets.env >> .env   (after scripts/generate-secrets.sh)
#
# Deploy with:  docker compose -f docker-compose.prod.yml up -d --build

# --- Public site ----------------------------------------------------------------
# Hostname Caddy serves (HTTPS via Let's Encrypt when ports 80/443 reach the internet).
DOMAIN=portal.example.com
ACME_EMAIL=admin@example.com
# Browser origins allowed by the API (comma-separated). Lock to HTTPS in production.
CORS_ORIGINS=https://portal.example.com
WEB_BASE_URL=https://portal.example.com

# --- App ------------------------------------------------------------------------
APP_ENV=production
APP_VERSION=0.1.0
LOG_LEVEL=INFO
ORG_NAME="Your Company"
NEXT_PUBLIC_API_URL=

# --- PostgreSQL -----------------------------------------------------------------
POSTGRES_USER=hrportal
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=hrportal

# --- Valkey / Celery ------------------------------------------------------------
# Host ports are not published in prod; URLs use the valkey service name.
REDIS_URL=redis://valkey:6379/0
CELERY_BROKER_URL=redis://valkey:6379/1
CELERY_RESULT_BACKEND=redis://valkey:6379/2

# --- Auth -----------------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- S3 / MinIO -----------------------------------------------------------------
MINIO_ROOT_USER=REPLACE_WITH_MINIO_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_MINIO_PASSWORD
S3_ENDPOINT_URL=http://minio:9000
# Presigned download URLs seen by browsers (same host as the portal unless you expose MinIO).
S3_PUBLIC_ENDPOINT_URL=https://portal.example.com
S3_ACCESS_KEY_ID=REPLACE_WITH_MINIO_USER
S3_SECRET_ACCESS_KEY=REPLACE_WITH_MINIO_PASSWORD
S3_BUCKET=cvs
S3_REGION=us-east-1

# --- SMTP (real provider in production) -----------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=hr@example.com
SMTP_FROM_NAME="HR Portal"

# --- Optional modules (all off for a minimal go-live) ---------------------------
ENABLE_PUBLIC_CAREERS=false
ENABLE_INTERVIEWS=false
ENABLE_OFFERS=false
ENABLE_REQUISITIONS=false
ENABLE_AUDIT_UI=false

# --- Security -------------------------------------------------------------------
API_RATE_LIMIT_PER_MINUTE=300
COOKIE_SECURE=true
TRUST_PROXY_HEADERS=true

# --- ClamAV (optional: docker compose --profile clamav) -------------------------
# Leave empty to skip scanning. Set to clamav when the clamav service is running.
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Backups --------------------------------------------------------------------
BACKUP_RETENTION_DAYS=14

# --- Retention (rejected candidates); 0 = disabled ------------------------------
RETENTION_REJECTED_DAYS=0