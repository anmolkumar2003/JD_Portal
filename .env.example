# Copy to .env and fill in real values:  cp .env.example .env
# Values below target tools run from your host (localhost). docker-compose.yml
# overrides hostnames (postgres, redis, minio, mailpit) for containers.
# Never commit .env.

# --- App ---------------------------------------------------------------------
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL ----------------------------------------------------------------
POSTGRES_USER=hrportal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hrportal
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://hrportal:change-me@localhost:5432/hrportal

# --- Redis / Celery ------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Auth (used from the auth slice onward) ------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- S3 / MinIO ----------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
# Endpoint browsers use for signed URLs
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-me-minio
S3_BUCKET=cvs
S3_REGION=us-east-1

# --- SMTP (Mailpit in development) ---------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=no-reply@hr-portal.local
SMTP_FROM_NAME=HR Portal
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Ports ---------------------------------------------------------------------
API_PORT=8000
WEB_PORT=3000

# --- Web -----------------------------------------------------------------------
# Browser-facing API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000
